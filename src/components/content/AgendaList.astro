---
type Props = {
  items: string[];
  title?: string;
};
const { items, title = 'On the agenda' } = Astro.props;
---
<div class="agenda">
  <h3>{title}</h3>
  <ol>
    {items.map((item) => (
      <li>
        <span class="agenda__bullet" aria-hidden="true"></span>
        <span>{item}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .agenda h3 {
    font-size: 1.25rem;
    margin: 0 0 1.25rem;
  }
  .agenda ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: a;
    border-top: 1px solid var(--c-rule);
  }
  .agenda li {
    counter-increment: a;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--c-rule);
    font-size: 1rem;
    line-height: 1.55;
  }
  .agenda__bullet {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--c-blue);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .agenda__bullet::before {
    content: counter(a, decimal-leading-zero);
  }
</style>
