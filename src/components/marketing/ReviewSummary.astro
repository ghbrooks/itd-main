---
import { site } from '~/lib/site';

type Props = {
  rating?: number;
  count?: number;
  href?: string;
};
const {
  rating = site.rating.value,
  count = site.rating.count,
  href = '/reviews',
} = Astro.props;
const fullStars = Math.floor(rating);
const fraction = rating - fullStars;
---
<a href={href} class="review-summary" aria-label={`Rated ${rating} out of 5 across ${count}+ reviews`}>
  <div class="review-summary__stars" aria-hidden="true">
    {Array.from({ length: 5 }, (_, i) => {
      const fill = i < fullStars ? 1 : i === fullStars ? fraction : 0;
      return (
        <span class="rs-star">
          <svg viewBox="0 0 16 16" width="20" height="20">
            <defs>
              <linearGradient id={`rsg-${i}`} x1="0" x2="1" y1="0" y2="0">
                <stop offset={`${fill * 100}%`} stop-color="currentColor"/>
                <stop offset={`${fill * 100}%`} stop-color="rgba(213, 222, 232, 1)"/>
              </linearGradient>
            </defs>
            <path d="M8 1l2.18 4.42 4.88.71-3.53 3.44.83 4.86L8 12.13 3.64 14.43l.83-4.86L.94 6.13l4.88-.71z" fill={`url(#rsg-${i})`} stroke="currentColor" stroke-width="0.6"/>
          </svg>
        </span>
      );
    })}
  </div>
  <div class="review-summary__text">
    <strong class="tabular">{rating.toFixed(1)}</strong>
    <span>over <strong class="tabular">{count}+</strong> reviews</span>
  </div>
</a>

<style>
  .review-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 1rem 0.6rem 0.85rem;
    border: 1px solid var(--c-rule);
    border-radius: 999px;
    background: var(--c-bg);
    color: var(--c-deep);
    text-decoration: none;
    transition:
      border-color 220ms var(--ease-out-soft),
      box-shadow 220ms var(--ease-out-soft);
  }
  .review-summary:hover {
    border-color: var(--c-blue);
    box-shadow: 0 8px 24px -16px rgba(2, 132, 213, 0.55);
    color: var(--c-deep);
  }
  .review-summary__stars {
    display: inline-flex;
    color: var(--c-blue);
    gap: 1px;
  }
  .review-summary__text {
    display: inline-flex;
    gap: 0.4rem;
    align-items: baseline;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
  .review-summary__text strong { color: var(--c-deep); font-weight: 600; }
</style>
