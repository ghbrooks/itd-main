---
type Props = {
  quote: string;
  author: string;
  role?: string;
  organisation?: string;
  rating?: number;
  layout?: 'inline' | 'feature';
  /** Optional headline the reviewer gave. */
  title?: string;
  date?: Date;
  /** Link to the course the review is about. */
  courseHref?: string;
  subject?: string;
};
const {
  quote,
  author,
  role,
  organisation,
  rating = 5,
  layout = 'inline',
  title,
  date,
  courseHref,
  subject,
} = Astro.props;
const stars = Array.from({ length: 5 }, (_, i) => i < rating);
const long = quote.length > 420;
---
<figure class={`testimonial testimonial--${layout}`} itemscope itemtype="https://schema.org/Review">
  <div class="testimonial__head">
    <div class="testimonial__rating" aria-label={`Rated ${rating} out of 5`}>
      {stars.map((filled) => (
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 1l2.18 4.42 4.88.71-3.53 3.44.83 4.86L8 12.13 3.64 14.43l.83-4.86L.94 6.13l4.88-.71z"
                fill={filled ? 'currentColor' : 'none'}
                stroke="currentColor"
                stroke-width="1"
                stroke-linejoin="round"/>
        </svg>
      ))}
    </div>
    {subject && (
      courseHref
        ? <a href={courseHref} class="testimonial__subject">{subject}</a>
        : <span class="testimonial__subject">{subject}</span>
    )}
  </div>
  {title && <p class="testimonial__title" itemprop="name">{title}</p>}
  <blockquote itemprop="reviewBody" class:list={{ 'is-long': long }}>
    <p>{quote}</p>
  </blockquote>
  {long && (
    <button type="button" class="testimonial__more" data-expand aria-expanded="false">Read more</button>
  )}
  <figcaption>
    <span class="testimonial__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
      <span itemprop="name">{author}</span>
    </span>
    {(role || organisation) && (
      <span class="testimonial__role">
        {role}{role && organisation ? ', ' : ''}{organisation}
      </span>
    )}
    {date && (
      <time class="testimonial__date" datetime={date.toISOString().slice(0, 10)} itemprop="datePublished">
        {date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' })}
      </time>
    )}
  </figcaption>
  <span itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating" hidden>
    <meta itemprop="ratingValue" content={String(rating)} />
    <meta itemprop="bestRating" content="5" />
  </span>
</figure>

<style>
  .testimonial {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.75rem;
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: 14px;
    height: 100%;
    margin: 0;
  }
  .testimonial--feature {
    padding: 2.5rem 2.5rem 2.25rem;
    background: linear-gradient(180deg, var(--c-tint) 0%, var(--c-bg) 80%);
    border-color: rgba(2, 132, 213, 0.18);
  }
  .testimonial__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .testimonial__rating {
    display: inline-flex;
    gap: 2px;
    color: var(--c-blue);
  }
  .testimonial__subject {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--c-mid);
    background: var(--c-tint);
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
    min-width: 0;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  a.testimonial__subject:hover { background: var(--c-deep); color: white; }
  .testimonial__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-deep);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .testimonial blockquote { margin: 0; flex: 1; }
  .testimonial blockquote p {
    margin: 0;
    color: var(--c-text);
    font-size: 1rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .testimonial blockquote.is-long:not(.is-open) p {
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .testimonial__more {
    align-self: flex-start;
    background: none;
    border: 0;
    padding: 0;
    color: var(--c-mid);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .testimonial--feature blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.65rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--c-deep);
  }
  .testimonial figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-rule);
  }
  .testimonial__author {
    font-weight: 600;
    color: var(--c-deep);
    font-size: 0.95rem;
  }
  .testimonial__role { color: var(--c-muted); font-size: 0.825rem; }
  .testimonial__date { color: var(--c-muted); font-size: 0.75rem; margin-top: 0.2rem; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const quote = btn.previousElementSibling as HTMLElement | null;
      const open = quote?.classList.toggle('is-open') ?? false;
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Show less' : 'Read more';
    });
  });
</script>
