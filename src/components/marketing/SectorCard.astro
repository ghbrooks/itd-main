---
type Props = {
  href: string;
  title: string;
  description?: string;
  count?: number;
};
const { href, title, description, count } = Astro.props;
---
<a href={href} class="sector-card card">
  <div class="sector-card__head">
    <h3>{title}</h3>
    {count !== undefined && <span class="sector-card__count">{count} courses</span>}
  </div>
  {description && <p>{description}</p>}
  <span class="sector-card__more">Explore <svg width="14" height="14" viewBox="0 0 14 14"><path d="M3 7h8m-3-3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
</a>

<style>
  .sector-card {
    display: block;
    padding: 1.75rem;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .sector-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .sector-card h3 {
    font-size: 1.35rem;
    color: var(--c-deep);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .sector-card__count {
    font-size: 0.75rem;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sector-card p {
    color: var(--c-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 1.25rem;
  }
  .sector-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--c-deep);
    font-weight: 500;
    font-size: 0.9rem;
    transition: gap 220ms var(--ease-out-soft);
  }
  .sector-card:hover .sector-card__more { gap: 0.7rem; }
</style>
