---
type Props = {
  href: string;
  client: string;
  sector?: string;
  title: string;
  excerpt?: string;
  size?: 'default' | 'feature';
};
const { href, client, sector, title, excerpt, size = 'default' } = Astro.props;
---
<a href={href} class={`case-card case-card--${size} card`}>
  <div class="case-card__top">
    <span class="case-card__client">{client}</span>
    {sector && <span class="case-card__sector">{sector}</span>}
  </div>
  <h3 class="case-card__title">{title}</h3>
  {excerpt && <p class="case-card__excerpt">{excerpt}</p>}
  <div class="case-card__foot">
    <span class="case-card__cta">Read the case study</span>
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
      <path d="M4 9h10m-3-3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</a>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.75rem 1.5rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
    background:
      linear-gradient(180deg, var(--c-bg) 0%, var(--c-bg-alt) 100%);
  }
  .case-card--feature {
    padding: 2.25rem 2.25rem 2rem;
    background:
      linear-gradient(135deg, var(--c-deep) 0%, #042863 60%, var(--c-mid) 100%);
    border-color: transparent;
    color: white;
  }
  .case-card--feature::after {
    background: linear-gradient(90deg, var(--c-sky), white);
  }

  .case-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .case-card__client {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--c-deep);
    letter-spacing: -0.01em;
  }
  .case-card--feature .case-card__client { color: white; }

  .case-card__sector {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-mid);
    background: var(--c-tint);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-weight: 600;
  }
  .case-card--feature .case-card__sector {
    background: rgba(255, 255, 255, 0.12);
    color: var(--c-sky);
  }

  .case-card__title {
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    line-height: 1.15;
    color: var(--c-deep);
    margin: 0 0 0.75rem;
    flex: 0;
    letter-spacing: -0.02em;
  }
  .case-card--feature .case-card__title { color: white; }

  .case-card__excerpt {
    color: var(--c-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }
  .case-card--feature .case-card__excerpt {
    color: rgba(255, 255, 255, 0.78);
  }

  .case-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-rule);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--c-deep);
  }
  .case-card--feature .case-card__foot {
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--c-sky);
  }
  .case-card:hover .case-card__cta {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
