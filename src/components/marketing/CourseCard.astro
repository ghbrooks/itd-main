---
type Props = {
  href: string;
  title: string;
  outcome?: string;
  category?: string;
  duration?: string;
  size?: 'default' | 'compact' | 'feature';
};
const { href, title, outcome, category, duration, size = 'default' } = Astro.props;
---
<a href={href} class={`course-card course-card--${size} card`}>
  <div class="course-card__body">
    {category && (
      <p class="course-card__cat">{category}</p>
    )}
    <h3 class="course-card__title">{title}</h3>
    {outcome && <p class="course-card__outcome">{outcome}</p>}
    <div class="course-card__foot">
      {duration && <span class="course-card__meta">{duration}</span>}
      <span class="course-card__arrow" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 22 22">
          <path d="M5 11h12m-4-4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .course-card {
    display: block;
    padding: 1.6rem 1.6rem 1.5rem;
    color: inherit;
    text-decoration: none;
    height: 100%;
    background: var(--c-bg);
  }
  .course-card--feature {
    padding: 2rem 2rem 1.85rem;
    background:
      linear-gradient(180deg, var(--c-tint) 0%, var(--c-bg) 70%);
    border-color: rgba(2, 132, 213, 0.18);
  }
  .course-card--compact { padding: 1.2rem 1.3rem; }

  .course-card__body { display: flex; flex-direction: column; gap: 0.6rem; height: 100%; }
  .course-card__cat {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-mid);
    font-weight: 600;
    margin: 0;
  }
  .course-card__title {
    font-size: 1.45rem;
    color: var(--c-deep);
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .course-card--compact .course-card__title { font-size: 1.15rem; }
  .course-card__outcome {
    color: var(--c-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }
  .course-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--c-rule);
  }
  .course-card__meta {
    font-size: 0.8rem;
    color: var(--c-muted);
    font-weight: 500;
  }
  .course-card__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px; height: 36px;
    border-radius: 999px;
    color: var(--c-deep);
    background: var(--c-tint);
    transition: transform 280ms var(--ease-out-soft), background 280ms var(--ease-out-soft), color 280ms var(--ease-out-soft);
  }
  .course-card:hover .course-card__arrow {
    transform: translateX(4px);
    background: var(--c-deep);
    color: white;
  }
</style>
