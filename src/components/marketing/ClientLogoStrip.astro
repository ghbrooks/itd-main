---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  heading?: string;
  tone?: 'light' | 'dark';
};
const { heading = 'Trusted by teams at', tone = 'light' } = Astro.props;

// Trimmed logos produced by scripts/trim-client-logos.mjs from the raw
// WordPress files in public/images/clients (which are ~917x693 canvases with
// the mark in a thin band in the middle).
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/clients/*.{png,webp,jpg,jpeg}',
  { eager: true },
);

// Proper names the filename rule can't derive; anything else is title-cased.
const names: Record<string, string> = {
  'atp-media': 'ATP Media',
  'cambridge-cognition': 'Cambridge Cognition',
  'clyde-co': 'Clyde & Co',
  'ee': 'EE',
  'esm': 'European Stability Mechanism',
  'ista': 'ISTA',
  'jcw-group': 'JCW Group',
  'law-society-scotland': 'Law Society of Scotland',
  'pankhurst': 'Pankhurst Trust',
  'pepsico': 'PepsiCo',
  'reed-smith': 'Reed Smith',
  'rma': 'RMA Associates',
  'tma': 'TMA',
  'van-bael-bellis': 'Van Bael & Bellis',
};

const logos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([file, mod]) => {
    const base = file.split('/').pop()!.replace(/\.[^.]+$/, '');
    const alt =
      names[base] ??
      base
        .split('-')
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(' ');
    return { src: mod.default, alt };
  });
---
<section class={`logo-strip logo-strip--${tone}`}>
  <div class="container-wide">
    <p class="eyebrow eyebrow-rule logo-strip__eyebrow">{heading}</p>
    <ul class="logo-strip__list">
      {logos.map((logo) => (
        <li>
          <Image
            src={logo.src}
            alt={logo.alt}
            height={160}
            densities={[1, 2]}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logo-strip {
    padding: 3rem 0;
    border-block: 1px solid var(--c-rule);
    background: var(--c-bg);
  }
  .logo-strip--dark {
    background: var(--c-deep);
    border-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
  }
  .logo-strip__eyebrow {
    margin-bottom: 1.75rem;
    color: var(--c-mid);
  }
  .logo-strip--dark .logo-strip__eyebrow {
    color: rgba(255, 255, 255, 0.7);
  }
  .logo-strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    align-items: center;
    justify-items: center;
  }
  @media (min-width: 640px) {
    .logo-strip__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 900px) {
    .logo-strip__list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (min-width: 1200px) {
    .logo-strip__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 2.5rem 2.5rem;
    }
  }
  .logo-strip__list li {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  /* Each logo gets the same box: wide wordmarks hit the width limit, square
     marks hit the height limit, and object-fit keeps the aspect ratio. */
  .logo-strip__list img {
    display: block;
    width: 100%;
    max-width: 152px;
    height: 58px;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.85;
    transition: opacity 220ms var(--ease-out-soft), filter 220ms var(--ease-out-soft);
  }
  @media (min-width: 640px) {
    .logo-strip__list img { height: 64px; max-width: 168px; }
  }
  .logo-strip__list li:hover img {
    opacity: 1;
    filter: grayscale(0);
  }
  .logo-strip--dark .logo-strip__list img {
    filter: grayscale(100%) brightness(0) invert(1);
    opacity: 0.85;
  }
  .logo-strip--dark .logo-strip__list li:hover img {
    opacity: 1;
  }
</style>
