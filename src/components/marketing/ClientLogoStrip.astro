---
import { site } from '~/lib/site';

type Props = {
  heading?: string;
  clients?: readonly string[];
  tone?: 'light' | 'dark';
};
const {
  heading = 'Trusted by teams at',
  clients = site.namedClients,
  tone = 'light',
} = Astro.props;
---
<section class={`logo-strip logo-strip--${tone}`}>
  <div class="container-wide">
    <p class="eyebrow eyebrow-rule logo-strip__eyebrow">{heading}</p>
    <ul class="logo-strip__list">
      {clients.map((client) => (
        <li><span class="logo-strip__name">{client}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logo-strip {
    padding: 3rem 0;
    border-block: 1px solid var(--c-rule);
    background: var(--c-bg);
  }
  .logo-strip--dark {
    background: var(--c-deep);
    border-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
  }
  .logo-strip__eyebrow {
    margin-bottom: 1.5rem;
    color: var(--c-mid);
  }
  .logo-strip--dark .logo-strip__eyebrow {
    color: rgba(255, 255, 255, 0.7);
  }
  .logo-strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .logo-strip__list { gap: 0.5rem 3.5rem; }
  }
  .logo-strip__name {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.35rem);
    font-weight: 600;
    color: var(--c-deep);
    letter-spacing: -0.01em;
    opacity: 0.78;
    transition: opacity 220ms var(--ease-out-soft);
    white-space: nowrap;
  }
  .logo-strip--dark .logo-strip__name {
    color: white;
    opacity: 0.85;
  }
  .logo-strip__list li:hover .logo-strip__name {
    opacity: 1;
  }
</style>
