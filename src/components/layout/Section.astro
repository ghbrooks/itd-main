---
type Props = {
  tone?: 'default' | 'alt' | 'tint' | 'deep';
  size?: 'sm' | 'md' | 'lg';
  as?: keyof HTMLElementTagNameMap;
  id?: string;
  class?: string;
};

const {
  tone = 'default',
  size = 'md',
  as: Tag = 'section',
  id,
  class: className = '',
} = Astro.props;

const toneClass = {
  default: '',
  alt: 'bg-[var(--c-bg-alt)]',
  tint: 'bg-[var(--c-tint)]',
  deep: 'bg-[var(--c-deep)] text-white',
}[tone];

const padClass = {
  sm: 'py-12 md:py-16',
  md: 'py-20 md:py-28',
  lg: 'py-24 md:py-36',
}[size];
---
<Tag id={id} class={`${toneClass} ${padClass} ${className} relative`.trim()}>
  <slot />
</Tag>
