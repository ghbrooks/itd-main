---
import Logo from '~/components/brand/Logo.astro';
import { primaryNav, type NavItem } from '~/lib/navigation';
import { groupBySlug } from '~/lib/training';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const currentSlug = currentPath.replace(/^\//, '');

function isActive(item: NavItem): boolean {
  if (currentPath === item.href || currentPath.startsWith(`${item.href}/`)) return true;
  if (item.href === '/training' && currentSlug in groupBySlug) return true;
  return (item.children ?? []).some(
    (c) => c.href === currentPath || (c.children ?? []).some((g) => g.href === currentPath),
  );
}

/** Training is the only item whose children have children: it gets the wide panel. */
const isMega = (item: NavItem) => Boolean(item.children?.some((c) => c.children?.length));
---
<header class="site-header">
  <div class="site-header__inner container-wide">
    <a href="/" class="site-header__brand" aria-label="ITD home">
      <Logo height={48} />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {primaryNav.map((item) => (
          <li class:list={['nav-item', { 'has-children': item.children, 'has-mega': isMega(item) }]}>
            <a href={item.href} class:list={[{ 'is-active': isActive(item) }]} aria-haspopup={item.children ? 'true' : undefined}>
              {item.label}
              {item.children && (
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                  <path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </a>

            {item.children && !isMega(item) && (
              <div class="dropdown">
                <ul class="dropdown__list">
                  {item.children.map((child) => (
                    <li><a href={child.href} class:list={[{ 'is-current': child.href === currentPath }]}>{child.label}</a></li>
                  ))}
                </ul>
                <a href={item.href} class="dropdown__all link-anim">All {item.label.toLowerCase()} →</a>
              </div>
            )}

            {item.children && isMega(item) && (
              <div class="mega">
                <div class="mega__inner container-wide">
                  <div class="mega__groups">
                    {item.children.map((group) => (
                      <section class:list={['mega__group', { 'mega__group--wide': (group.children?.length ?? 0) > 16 }]}>
                        <h3><a href={group.href}>{group.label}</a></h3>
                        <ul>
                          {(group.children ?? []).map((course) => (
                            <li><a href={course.href} class:list={[{ 'is-current': course.href === currentPath }]}>{course.label}</a></li>
                          ))}
                        </ul>
                      </section>
                    ))}
                  </div>
                  <div class="mega__foot">
                    <p>{item.description}</p>
                    <a href={item.href} class="btn btn--ghost btn--mini">All training courses</a>
                  </div>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__cta">
      <a href="/contact" class="btn btn--primary btn--mini">
        Tell us your challenge
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M3 7h8m-3-3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <button class="site-header__burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-mobile-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="site-header__mobile" id="mobile-menu" data-mobile-panel hidden>
    <ul class="mobile__list">
      {primaryNav.map((item) =>
        item.children ? (
          <li>
            <details open={isActive(item)}>
              <summary>
                <span>{item.label}</span>
                <svg width="12" height="12" viewBox="0 0 10 10" aria-hidden="true">
                  <path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <ul class="mobile__sub">
                <li><a href={item.href} class="mobile__all">All {item.label.toLowerCase()}</a></li>
                {item.children.map((child) =>
                  child.children ? (
                    <li>
                      <details>
                        <summary><span>{child.label}</span>
                          <svg width="12" height="12" viewBox="0 0 10 10" aria-hidden="true">
                            <path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </summary>
                        <ul class="mobile__sub">
                          {child.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                        </ul>
                      </details>
                    </li>
                  ) : (
                    <li><a href={child.href}>{child.label}</a></li>
                  ),
                )}
              </ul>
            </details>
          </li>
        ) : (
          <li><a href={item.href} class="mobile__top">{item.label}</a></li>
        ),
      )}
      <li class="mobile__cta">
        <a href="/contact" class="btn btn--primary">Tell us your challenge</a>
      </li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--c-bg) 90%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--c-rule);
  }
  .site-header__inner {
    position: relative;
    display: grid;
    /* Brand never collapses; nav takes the rest and may wrap its items. */
    grid-template-columns: max-content minmax(0, 1fr) max-content;
    align-items: center;
    gap: 1.25rem;
    min-height: 104px;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    transition: transform 200ms var(--ease-out-soft);
  }
  .site-header__brand:hover { transform: translateY(-1px); }

  /* ---------------------------------------------------------------- nav */
  .site-header__nav { justify-self: center; }
  .site-header__nav > ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-item { position: relative; }
  /* Hover bridge: keeps :hover alive while the cursor crosses the gap to the panel. */
  .has-children::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 14px;
  }
  .site-header__nav > ul > li > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    color: var(--c-text);
    font-size: 0.88rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 180ms var(--ease-out-soft), background 180ms var(--ease-out-soft);
  }
  @media (min-width: 1480px) {
    .site-header__nav > ul { gap: 0.2rem; }
    .site-header__nav > ul > li > a { font-size: 0.95rem; padding: 0.55rem 0.8rem; }
  }
  .site-header__nav > ul > li > a:hover,
  .site-header__nav > ul > li > a.is-active,
  .nav-item:focus-within > a {
    color: var(--c-deep);
    background: var(--c-tint);
  }

  /* Shared panel behaviour */
  .dropdown,
  .mega {
    position: absolute;
    top: calc(100% + 10px);
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition: transform 220ms var(--ease-out-soft), opacity 220ms var(--ease-out-soft);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    box-shadow: 0 30px 60px -28px rgba(1, 33, 92, 0.3);
  }
  .has-children:hover > .dropdown,
  .has-children:focus-within > .dropdown,
  .has-mega:hover > .mega,
  .has-mega:focus-within > .mega {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Flat dropdown */
  .dropdown {
    left: 0;
    min-width: 260px;
    border-radius: 14px;
    padding: 0.85rem;
  }
  .nav-item:nth-last-child(-n+4) .dropdown { left: auto; right: 0; }
  .dropdown__list { list-style: none; margin: 0; padding: 0; }
  .dropdown__list a,
  .mega__group a {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    color: var(--c-text);
    font-size: 0.88rem;
    line-height: 1.3;
    transition: background 160ms var(--ease-out-soft), color 160ms var(--ease-out-soft);
  }
  .dropdown__list a:hover,
  .mega__group li a:hover,
  .dropdown__list a.is-current,
  .mega__group a.is-current {
    background: var(--c-tint);
    color: var(--c-deep);
  }
  .dropdown__all {
    display: inline-block;
    margin: 0.6rem 0.6rem 0.2rem;
    font-size: 0.8rem;
  }

  /* Mega panel for Training: spans the header container */
  .has-mega { position: static; }
  .mega {
    left: 0;
    right: 0;
    border-radius: 0 0 18px 18px;
    max-height: calc(100vh - 130px);
    overflow-y: auto;
  }
  .mega__inner { padding-top: 1.75rem; padding-bottom: 1.5rem; }
  .mega__groups {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem 1.75rem;
  }
  .mega__group--wide { grid-column: span 2; }
  .mega__group--wide ul { columns: 2; column-gap: 1.25rem; }
  .mega__group--wide li { break-inside: avoid; }
  .mega__group h3 {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    padding: 0 0.6rem 0.5rem;
    border-bottom: 1px solid var(--c-rule);
  }
  .mega__group h3 a { padding: 0; color: var(--c-mid); font-size: inherit; }
  .mega__group h3 a:hover { color: var(--c-blue); background: none; }
  .mega__group ul { list-style: none; margin: 0; padding: 0; }
  .mega__group li a { padding: 0.28rem 0.6rem; font-size: 0.84rem; }
  .mega__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-rule);
  }
  .mega__foot p { margin: 0; color: var(--c-muted); font-size: 0.9rem; max-width: 60ch; }

  /* ---------------------------------------------------------------- cta */
  .site-header__cta { display: none; }
  @media (min-width: 1280px) { .site-header__cta { display: inline-flex; } }

  /* ---------------------------------------------------------------- burger */
  .site-header__burger {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    justify-content: center;
    align-items: center;
    background: none;
    border: 0;
    padding: 0.5rem;
    cursor: pointer;
    width: 44px;
    height: 44px;
    justify-self: end;
    border-radius: 8px;
    transition: background 180ms var(--ease-out-soft);
  }
  .site-header__burger:hover { background: var(--c-tint); }
  .site-header__burger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--c-deep);
    border-radius: 2px;
    transition: transform 200ms var(--ease-out-soft), opacity 200ms var(--ease-out-soft);
  }
  .site-header__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .site-header__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .site-header__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (min-width: 1024px) { .site-header__burger { display: none; } }
  @media (max-width: 1023px) {
    .site-header__nav { display: none; }
    .site-header__inner { grid-template-columns: auto auto; justify-content: space-between; min-height: 84px; }
  }

  /* ---------------------------------------------------------------- mobile */
  .site-header__mobile {
    border-top: 1px solid var(--c-rule);
    background: var(--c-bg);
    max-height: calc(100vh - 85px);
    overflow-y: auto;
    padding: 0.5rem clamp(1.25rem, 4vw, 2.5rem) 1.5rem;
  }
  .site-header__mobile ul { list-style: none; margin: 0; padding: 0; }
  .mobile__list > li { border-bottom: 1px solid var(--c-rule); }
  .mobile__list > li:last-child { border-bottom: 0; }
  .site-header__mobile a,
  .site-header__mobile summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 0;
    color: var(--c-text);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .site-header__mobile summary::-webkit-details-marker { display: none; }
  .site-header__mobile summary svg { transition: transform 200ms var(--ease-out-soft); color: var(--c-muted); }
  .site-header__mobile details[open] > summary svg { transform: rotate(180deg); }
  .site-header__mobile details[open] > summary { color: var(--c-deep); }
  .mobile__sub { padding: 0 0 0.5rem 1rem; }
  .mobile__sub a,
  .mobile__sub summary {
    padding: 0.5rem 0;
    font-size: 0.92rem;
    font-weight: 400;
    color: var(--c-muted);
  }
  .mobile__sub summary { font-weight: 500; color: var(--c-text); }
  .mobile__all { color: var(--c-mid) !important; font-weight: 500 !important; }
  .mobile__cta { padding-top: 1rem; }
  .mobile__cta .btn { justify-content: center; width: 100%; }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-panel]');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.toggleAttribute('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    toggle.addEventListener('click', () => setOpen(panel.hasAttribute('hidden')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hasAttribute('hidden')) setOpen(false);
    });
  }
</script>
