---
import { getCollection, render } from 'astro:content';
import CourseLayout from '~/layouts/CourseLayout.astro';
import CaseStudyLayout from '~/layouts/CaseStudyLayout.astro';
import SectorLayout from '~/layouts/SectorLayout.astro';
import LocationLayout from '~/layouts/LocationLayout.astro';

export async function getStaticPaths() {
  const [courses, caseStudies, sectors, locations] = await Promise.all([
    getCollection('courses'),
    getCollection('caseStudies'),
    getCollection('sectors'),
    getCollection('locations'),
  ]);

  return [
    ...courses.map((entry) => ({
      params: { slug: entry.slug },
      props: { kind: 'course' as const, entry },
    })),
    ...caseStudies.map((entry) => ({
      params: { slug: entry.slug },
      props: { kind: 'caseStudy' as const, entry },
    })),
    ...sectors.map((entry) => ({
      params: { slug: entry.slug },
      props: { kind: 'sector' as const, entry },
    })),
    ...locations.map((entry) => ({
      params: { slug: entry.slug },
      props: { kind: 'location' as const, entry },
    })),
  ];
}

const { kind, entry } = Astro.props;
const { Content } = await render(entry);
---
{kind === 'course' && (
  <CourseLayout course={entry}>
    <Content />
  </CourseLayout>
)}
{kind === 'caseStudy' && <CaseStudyLayout study={entry} />}
{kind === 'sector' && (
  <SectorLayout sector={entry}>
    <Content />
  </SectorLayout>
)}
{kind === 'location' && (
  <LocationLayout location={entry}>
    <Content />
  </LocationLayout>
)}
