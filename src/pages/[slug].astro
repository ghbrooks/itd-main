---
import { getCollection, render } from 'astro:content';
import CourseLayout from '~/layouts/CourseLayout.astro';
import CaseStudyLayout from '~/layouts/CaseStudyLayout.astro';
import SectorLayout from '~/layouts/SectorLayout.astro';
import LocationLayout from '~/layouts/LocationLayout.astro';
import PageLayout from '~/layouts/PageLayout.astro';

/**
 * Single catch-all for every content collection that lives at the site root.
 * Slugs must be unique across collections; a clash is reported at build time
 * rather than silently picking a winner.
 */
export async function getStaticPaths() {
  const [courses, caseStudies, sectors, locations, pages] = await Promise.all([
    getCollection('courses'),
    getCollection('caseStudies'),
    getCollection('sectors'),
    getCollection('locations'),
    getCollection('pages'),
  ]);

  const paths = [
    ...courses.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'course' as const, entry } })),
    ...caseStudies.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'caseStudy' as const, entry } })),
    ...sectors.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'sector' as const, entry } })),
    ...locations.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'location' as const, entry } })),
    ...pages.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'page' as const, entry } })),
  ];

  const seen = new Map<string, string>();
  for (const p of paths) {
    const prev = seen.get(p.params.slug);
    if (prev) throw new Error(`Duplicate slug "/${p.params.slug}" in collections ${prev} and ${p.props.kind}`);
    seen.set(p.params.slug, p.props.kind);
  }
  return paths;
}

const { kind, entry } = Astro.props;
const { Content } = await render(entry);
---
{kind === 'course' && (
  <CourseLayout course={entry}>
    <Content />
  </CourseLayout>
)}
{kind === 'caseStudy' && <CaseStudyLayout study={entry} />}
{kind === 'sector' && (
  <SectorLayout sector={entry}>
    <Content />
  </SectorLayout>
)}
{kind === 'location' && (
  <LocationLayout location={entry}>
    <Content />
  </LocationLayout>
)}
{kind === 'page' && (
  <PageLayout page={entry}>
    <Content />
  </PageLayout>
)}
