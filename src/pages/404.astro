---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for has moved or doesn’t exist."
  noindex
>
  <Section size="lg" tone="default">
    <div class="container-wide nf">
      <p class="nf__code display tabular">404</p>
      <h1 class="nf__title">That page has gone for a walk.</h1>
      <p class="nf__lede">
        Most likely a stale link, or a page that was retired in our last rebuild. Try one of these instead — or tell us what you were after.
      </p>
      <div class="nf__actions">
        <a href="/" class="btn btn--primary">
          Home
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M3 7h8m-3-3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/contact" class="btn btn--ghost">Get in touch</a>
      </div>

      <div class="nf__links">
        <p class="eyebrow eyebrow-rule">Likely you wanted</p>
        <ul>
          <li><a href="/soft-skills-training" class="link-anim">All training</a></li>
          <li><a href="/sales-training" class="link-anim">Sales training</a></li>
          <li><a href="/presentation-skills-training" class="link-anim">Presentation skills</a></li>
          <li><a href="/leadership-training" class="link-anim">Leadership</a></li>
          <li><a href="/case-studies" class="link-anim">Case studies</a></li>
          <li><a href="/reviews" class="link-anim">Reviews</a></li>
        </ul>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .nf {
    max-width: 720px;
    margin: 0 auto;
    text-align: left;
    padding: 4rem 0 2rem;
  }
  .nf__code {
    font-size: clamp(5rem, 14vw, 10rem);
    line-height: 0.9;
    color: var(--c-blue);
    opacity: 0.18;
    margin: 0 0 1rem;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .nf__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
  }
  .nf__lede {
    font-size: 1.15rem;
    color: var(--c-muted);
    line-height: 1.55;
    max-width: 52ch;
    margin: 0 0 2rem;
  }
  .nf__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .nf__links { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--c-rule); }
  .nf__links ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.65rem 1.5rem;
  }
</style>
