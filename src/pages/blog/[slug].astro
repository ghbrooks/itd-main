---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/marketing/Hero.astro';
import Section from '~/components/layout/Section.astro';
import CTAPanel from '~/components/marketing/CTAPanel.astro';
import { articleSchema, breadcrumbSchema } from '~/lib/schema';
import { site } from '~/lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const url = `${site.url}/blog/${entry.slug}`;
const schemas = [
  articleSchema({
    headline: data.title,
    description: data.seo.description,
    url,
    publishedDate: data.publishedDate,
    author: data.author,
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: data.title, url: `/blog/${entry.slug}` },
  ]),
];
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  type="article"
  schemas={schemas}
>
  <Hero
    eyebrow={`Blog · ${data.category}`}
    title={data.title}
    lead={data.description}
    variant="page"
    primaryCta={{ label: 'Tell us your challenge', href: '/contact' }}
  />

  <Section size="md" tone="default">
    <article class="container-narrow prose">
      <p class="byline">
        By {data.author} ·{' '}
        {data.publishedDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <Content />
    </article>
  </Section>

  <CTAPanel
    eyebrow="Want training that lands?"
    title="Tell us what your team is working on."
    primary={{ label: 'Start the conversation', href: '/contact' }}
    tone="deep"
  />
</BaseLayout>

<style>
  .prose { max-width: 70ch; }
  .byline {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-muted);
    margin: 0 0 2.5rem;
  }
  .prose :global(h2) {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    letter-spacing: -0.02em;
    margin: 2.5rem 0 1rem;
  }
  .prose :global(h3) {
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
  }
  .prose :global(p) {
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 0 1rem;
  }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; margin: 0 0 1.25rem; }
  .prose :global(li) { margin: 0.4rem 0; line-height: 1.6; }
  .prose :global(strong) { color: var(--c-deep); font-weight: 600; }
</style>
